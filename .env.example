# Copy to .env (never commit .env). Only VITE_* values reach the browser, and only public ones belong there.
# With the Supabase values empty, accounts and Pro stay off and the site works exactly like the account-free version.

# --- Browser (public) ---------------------------------------------------------------------------------------
# Supabase → Project Settings → API. Use the *publishable* key (sb_publishable_…), never a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Lemon Squeezy → Products → Your Sky Pro → Share → checkout link (https://STORE.lemonsqueezy.com/checkout/buy/VARIANT_UUID).
# Setting this turns Pro on (and strips Pro-only fields from the public school data in production builds).
VITE_LEMON_CHECKOUT_URL=
# Lemon Squeezy → Affiliates → settings → store slug, for the affiliate tracking script.
VITE_LEMON_STORE=
# Price shown on the paywall; must match the Lemon Squeezy product.
VITE_PRO_PRICE=$4.99
# Dev only: 1 = fake in-browser backend for trying accounts/Pro/friends with `npm run dev` (email code 000000).
VITE_MOCK_BACKEND=

# --- Server only: Edge Function secrets (supabase secrets set --env-file supabase/.env.functions) -------------
# Never prefix these with VITE_. SUPABASE_URL, SUPABASE_SECRET_KEYS, SUPABASE_PUBLISHABLE_KEYS and SUPABASE_JWKS
# are provided to Edge Functions automatically.
# Lemon Squeezy → Settings → Webhooks → signing secret.
LEMON_WEBHOOK_SECRET=
# The Pro product's variant id, so other products in the store never grant Pro (optional but recommended).
LEMON_VARIANT_ID=
# Extra browser origins allowed to call the functions, comma-separated (findyoursky.com, *.pages.dev previews and
# localhost are always allowed).
ALLOWED_ORIGINS=

# --- Local scripts only -------------------------------------------------------------------------------------
# api.data.gov key for scripts/build_data.py.
SCORECARD_API_KEY=
# For scripts/import_supabase.py: the project URL and a *secret* key (sb_secret_…). Keep out of the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
